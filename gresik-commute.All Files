    // ==================== AI CCTV MONITOR ====================
    function renderCctvSvg(cam) {
      const boxesSvg = cam.boxes.map(b => `
        <g>
          <rect x="${b.x}%" y="${b.y}%" width="${b.w}%" height="${b.h}%" fill="${b.color}22" stroke="${b.color}" stroke-width="2" rx="4" />
          <rect x="${b.x}%" y="${Math.max(4, b.y - 9)}%" width="${Math.min(48, b.w + 10)}%" height="9%" fill="${b.color}" rx="3" />
          <text x="${b.x + 1.5}%" y="${Math.max(10.5, b.y - 2.5)}%" fill="#0f172a" font-size="10" font-weight="800" font-family="JetBrains Mono">${b.label}</text>
        </g>
      `).join('');

      return `
        <div class="relative w-full aspect-video bg-slate-950 rounded-xl overflow-hidden border border-slate-800">
          <!-- Simulated Road Perspective SVG -->
          <svg viewBox="0 0 400 225" class="w-full h-full">
            <rect width="400" height="225" fill="#0b1120" />
            <!-- Horizon & Sky -->
            <rect width="400" height="65" fill="#1e293b" opacity="0.5" />
            <!-- Industrial silhouettes -->
            <rect x="20" y="30" width="45" height="35" fill="#334155" opacity="0.5" />
            <rect x="310" y="25" width="60" height="40" fill="#334155" opacity="0.5" />
            <!-- Asphalt Perspective -->
            <polygon points="110,65 290,65 395,225 5,225" fill="#1e293b" />
            <line x1="200" y1="65" x2="200" y2="225" stroke="#f59e0b" stroke-width="2" stroke-dasharray="12,10" opacity="0.6" />
            <!-- Stylized Truck & Motor Silhouettes -->
            <rect x="65" y="92" width="115" height="72" rx="6" fill="#475569" />
            <rect x="205" y="100" width="105" height="65" rx="6" fill="#334155" />
            <rect x="85" y="175" width="165" height="32" rx="6" fill="#0f172a" opacity="0.85" />
            <!-- AI Computer Vision Bounding Boxes -->
            ${boxesSvg}
          </svg>
          <!-- Scanline Effect -->
          <div class="cctv-scanline absolute inset-x-0 h-8 bg-gradient-to-b from-transparent via-sky-400/15 to-transparent pointer-events-none"></div>
          <!-- Overlay HUD -->
          <div class="absolute top-2.5 left-2.5 bg-slate-950/80 backdrop-blur px-2.5 py-1 rounded-md border border-slate-700 font-mono text-[10px] text-emerald-400 flex items-center gap-1.5">
