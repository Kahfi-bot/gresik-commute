    // Live Clock & Dynamic Shift Detector
    function updateClock() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('id-ID', { hour12: false }) + " WIB";
      document.getElementById('live-clock').textContent = timeStr;

      const hour = now.getHours();
      const shiftLabel = document.getElementById('shift-label');
      if (hour >= 5 && hour < 13) {
        shiftLabel.textContent = "Sif 1 Pagi (07:00)";
      } else if (hour >= 13 && hour < 21) {
        shiftLabel.textContent = "Sif 2 Sore (15:00)";
      } else {
        shiftLabel.textContent = "Sif 3 Malam (23:00)";
      }
    }

    // Tab Navigation
    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById('tab-' + tabName).classList.remove('hidden');

      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-amber-500', 'text-slate-950', 'shadow-md', 'shadow-amber-500/20');
        btn.classList.add('text-slate-300', 'hover:bg-slate-800');
      });

      const activeBtn = document.getElementById('tab-btn-' + tabName);
      activeBtn.classList.remove('text-slate-300', 'hover:bg-slate-800');
      activeBtn.classList.add('bg-amber-500', 'text-slate-950', 'shadow-md', 'shadow-amber-500/20');
    }

    // Toast Helper (No alert() used!)
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = type === 'success'
        ? 'bg-emerald-950/95 border-emerald-500 text-emerald-100'
        : 'bg-amber-950/95 border-amber-500 text-amber-100';

      toast.className = `pointer-events-auto border ${colors} px-4 py-3 rounded-xl shadow-2xl text-xs font-medium flex items-center justify-between gap-3 transition-all duration-300`;
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

