    function renderCrowdReports() {
      const list = document.getElementById('crowd-feed-list');
      document.getElementById('report-count-badge').textContent = crowdReports.length;

      list.innerHTML = crowdReports.map(rep => `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 transition hover:border-slate-700">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
            <span class="px-2.5 py-0.5 rounded-md bg-rose-500/15 text-rose-300 border border-rose-500/30 text-[11px] font-bold">
              ${rep.category}
            </span>
            <span class="text-[11px] text-slate-400">${rep.time}</span>
          </div>
          <h4 class="font-bold text-sm text-white">${rep.location}</h4>
          <p class="text-xs text-slate-300 mt-1 leading-relaxed">${rep.note}</p>
          <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-slate-800">
            <span class="text-[11px] text-slate-400">Oleh: <strong class="text-slate-300">${rep.reporter}</strong></span>
            <button onclick="upvoteReport(${rep.id})" class="px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition ${
              rep.voted
                ? 'bg-emerald-500 text-slate-950'
                : 'bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-emerald-500/30'
            }">
              <span>👍 Valid / Masih Macet</span>
              <span class="font-mono">(${rep.upvotes})</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    function submitCrowdReport(e) {
      e.preventDefault();
      const location = document.getElementById('rep-location').value;
      const category = document.getElementById('rep-category').value;
      const note = document.getElementById('rep-note').value.trim();
      const reporterInput = document.getElementById('rep-reporter').value.trim();
      const reporter = reporterInput || "Komuter Gresik (Terverifikasi)";

      const newReport = {
        id: Date.now(),
        location,
        category,
        note,
        reporter,
        time: "Baru saja",
        upvotes: 1,
        voted: true
      };

      crowdReports.unshift(newReport);
      userPoints += 15;
      document.getElementById('user-trust-points').textContent = userPoints;
      document.getElementById('crowd-report-form').reset();
      renderCrowdReports();
      showToast("Laporan berhasil dipublikasikan ke peta Gresik! (+15 Poin Komunitas)");
    }

    function upvoteReport(id) {
      const target = crowdReports.find(r => r.id === id);
      if (!target) return;
      if (!target.voted) {
        target.upvotes += 1;
        target.voted = true;
        userPoints += 5;
        document.getElementById('user-trust-points').textContent = userPoints;
        renderCrowdReports();
        showToast("Terima kasih telah memvalidasi kondisi jalan! (+5 Poin)");
      }
    }
  </script>
</body>
</html>